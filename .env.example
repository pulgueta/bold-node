# Bold SDK credentials. Copy to `.env` and fill with your dashboard keys.
# Each Bold integration surface has its OWN identity + secret key pair
# (panel.bold.co › Integraciones › Llaves de integración) — they are different
# values, hence different variable names. Use the sandbox keys for testing.

# API Integrations (datáfono / POS app-checkout, terminals, payment-methods)
BOLD_API_INTEGRATIONS_IDENTITY_KEY=
BOLD_API_INTEGRATIONS_SECRET_KEY=

# Payment Button / API Link de pagos / transaction voucher status
BOLD_PAYMENT_BUTTON_IDENTITY_KEY=
BOLD_PAYMENT_BUTTON_SECRET_KEY=

# Online Payments API (API Pagos en Línea, BETA — requires activation)
BOLD_ONLINE_IDENTITY_KEY=
BOLD_ONLINE_SECRET_KEY=
