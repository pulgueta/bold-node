{
  "name": "@pulgueta/bold",
  "description": "Node.js SDK for the Bold payments API (Colombia) — App Integrations, Online Payments API, payment links, webhooks, and framework adapters.",
  "version": "1.0.1",
  "author": "Andrés Rodríguez",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/pulgueta/bold-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulgueta/bold-node.git"
  },
  "bugs": {
    "url": "https://github.com/pulgueta/bold-node/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./next": {
      "import": "./dist/adapters/next.js",
      "types": "./dist/adapters/next.d.ts"
    },
    "./hono": {
      "import": "./dist/adapters/hono.js",
      "types": "./dist/adapters/hono.d.ts"
    },
    "./express": {
      "import": "./dist/adapters/express.js",
      "types": "./dist/adapters/express.d.ts"
    },
    "./tanstack": {
      "import": "./dist/adapters/tanstack.js",
      "types": "./dist/adapters/tanstack.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "sandbox": "tsx examples/sandbox/verify.ts",
    "skills:install": "skills-npm install",
    "clean": "rm -rf dist && rm -rf node_modules",
    "prepack": "pnpm build"
  },
  "keywords": [
    "bold",
    "bold-node",
    "bold-colombia",
    "bold-payments",
    "payments",
    "sdk",
    "webhooks",
    "nextjs",
    "express",
    "hono",
    "tanstack"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.4",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "express": "^5.2.1",
    "hono": "^4.12.27",
    "semantic-release": "^25.0.5",
    "skills-npm": "^1.2.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.9.0",
  "peerDependencies": {
    "express": ">=4",
    "hono": ">=4",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
